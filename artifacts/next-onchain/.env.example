# Postgres connection string used by the deposits API (@workspace/db).
DATABASE_URL=postgres://user:password@localhost:5432/usdc_yield_base

# Coinbase Developer Platform paymaster/bundler RPC URL forwarded by
# app/api/paymaster/route.ts to sponsor gas for deposit transactions.
PAYMASTER_RPC_URL=

# Optional: override the Base mainnet RPC used server-side to verify
# reported deposits on-chain (app/api/deposits/route.ts). Defaults to the
# public https://mainnet.base.org endpoint if unset.
BASE_RPC_URL=

# OnchainKit API key (client-exposed), from the Coinbase Developer Platform.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Optional: WalletConnect project ID. When unset, the WalletConnect
# connector is not registered and only injected/Coinbase Wallet are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: enables app/api/debug/vault-apys, a read-only route for
# inspecting Morpho's raw per-vault response. Off (unset/false) everywhere
# by default, including production — it has no auth of its own.
ENABLE_DEBUG_ENDPOINT=false
