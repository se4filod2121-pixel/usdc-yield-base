# Postgres connection string used by the deposits API (@workspace/db).
DATABASE_URL=postgres://user:password@localhost:5432/usdc_yield_base

# Coinbase Developer Platform paymaster/bundler RPC URL forwarded by
# app/api/paymaster/route.ts to sponsor gas for deposit transactions.
PAYMASTER_RPC_URL=

# Optional: override the Base mainnet RPC used server-side to verify
# reported deposits on-chain (app/api/deposits/route.ts). Defaults to the
# public https://mainnet.base.org endpoint if unset.
BASE_RPC_URL=

# OnchainKit API key (client-exposed), from the Coinbase Developer Platform.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Optional: WalletConnect project ID. When unset, the WalletConnect
# connector is not registered and only injected/Coinbase Wallet are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: enables app/api/debug/vault-apys, a read-only route for
# inspecting Morpho's raw per-vault response. Off (unset/false) everywhere
# by default, including production — it has no auth of its own.
ENABLE_DEBUG_ENDPOINT=false

# x402-gated agent API (app/api/agent/*, see lib/x402Server.ts). All three
# are optional — they default to Base Sepolia, the wallet that already
# receives the deposit fee, and the public x402.org facilitator.
#
# CAIP-2 network id for x402 payment verification. Defaults to
# "eip155:84532" (Base Sepolia) because the public facilitator below does
# not support the "exact" scheme on Base mainnet ("eip155:8453") — only set
# this to mainnet once X402_FACILITATOR_URL also points at a facilitator
# that actually settles mainnet USDC.
X402_NETWORK=eip155:84532
# x402 facilitator URL that verifies/settles agent payments. Point this at a
# production facilitator (e.g. one backed by @coinbase/x402 + a CDP API key)
# before relying on this — and before switching X402_NETWORK to mainnet.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Wallet that receives x402 payments for the agent API. Defaults to the same
# wallet as the deposit fee (FEE_RECIPIENT) if unset.
X402_PAY_TO=
